---
const items = [
  { icon: "code", label: "Free & Open Source" },
  { icon: "swift", label: "Native Swift" },
  { icon: "lock", label: "Zero Data Collection" },
];
---

<section class="relative py-6 border-b border-separator/20 bg-gradient-to-b from-bg-primary to-bg-surface/20">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-sm text-text-secondary">
      {items.map((item) => (
        <div class="glass-subtle rounded-full px-4 py-2 flex items-center gap-2.5">
          {item.icon === "code" && (
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" class="text-accent">
              <path d="M5.5 4L1.5 8l4 4M10.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {item.icon === "swift" && (
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" class="text-urgency-high">
              <path d="M12.5 2.5c-3 1-6.5 5-8.5 8 3-1 5.5-3 7-5-1 3-3.5 6-6.5 8 2 0 5-1.5 7-4 .5 1.5.5 3-.5 4.5 2-1.5 3-4 2.5-6.5.5-1.5 0-3.5-1-5z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {item.icon === "lock" && (
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" class="text-urgency-low">
              <rect x="3.5" y="7" width="9" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5" />
              <path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          )}
          <span class="text-[13px]">{item.label}</span>
        </div>
      ))}

      <span class="hidden sm:inline text-accent/30 text-xs">&#9670;</span>

      <!-- Calendar integrations -->
      <div class="glass-subtle rounded-full px-4 py-2 flex items-center gap-3">
        <span class="text-text-tertiary text-[13px]">Works with</span>
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-md bg-bg-surface ring-1 ring-separator/20 flex items-center justify-center overflow-hidden" title="Google Calendar">
            <img src="/gcal.svg" class="w-4 h-4" alt="Google Calendar" width="16" height="16" />
          </div>
          <div class="w-6 h-6 rounded-md bg-white ring-1 ring-separator/20 flex items-center justify-center overflow-hidden" title="Apple Calendar">
            <img src="/applecal.svg" class="w-6 h-6" alt="Apple Calendar" width="24" height="24" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
