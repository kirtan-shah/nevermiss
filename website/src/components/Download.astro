---

---

<section id="download" class="relative pt-28 sm:pt-36 pb-24 sm:pb-32 overflow-hidden">
  <!-- Atmospheric background -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="hero-glow-far absolute inset-0"></div>
    <div class="hero-glow-mid absolute inset-0"></div>
  </div>

  <!-- Radar circles -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none" aria-hidden="true">
    <div class="relative w-[500px] h-[500px]">
      <div class="absolute inset-0 rounded-full border border-separator/[0.04]" style="animation: pulse-ring 8s ease-out infinite;"></div>
      <div class="absolute inset-16 rounded-full border border-separator/[0.05]" style="animation: pulse-ring 8s ease-out 2.5s infinite;"></div>
      <div class="absolute inset-32 rounded-full border border-separator/[0.06]" style="animation: pulse-ring 8s ease-out 5s infinite;"></div>
    </div>
  </div>

  <div class="relative max-w-2xl mx-auto px-6 text-center">
    <div class="reveal">
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.08] mb-5">
        Ready to be on time?
      </h2>
      <p class="text-text-secondary text-lg sm:text-xl font-light mb-10 max-w-md mx-auto leading-relaxed">
        Open source and built for macOS. If you find it useful, consider supporting development.
      </p>
    </div>

    <div class="reveal flex flex-col items-center gap-5">
      <!-- Primary CTA -->
      <a
        href="https://ko-fi.com/s/711502489b"
        target="_blank"
        rel="noopener"
        class="group relative inline-flex items-center gap-3 px-10 py-5 rounded-full bg-gradient-to-r from-accent to-[#7FBFFF] text-white font-semibold text-lg transition-all duration-300 hover:shadow-[0_0_60px_rgba(94,158,255,0.3)] hover:scale-[1.03] bg-[length:200%_auto] animate-gradient-shift"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="shrink-0 transition-transform duration-200 group-hover:translate-y-0.5">
          <path d="M10 2.5v11.25M5.625 9.375L10 13.75l4.375-4.375" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M3.125 17.5h13.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        Download for macOS
      </a>

      <!-- macOS badge -->
      <span class="text-xs text-text-tertiary">Requires macOS 15 Sequoia or later</span>

      <!-- Secondary links -->
      <div class="flex items-center gap-6 mt-3">
        <a
          href="https://ko-fi.com/makercodes"
          target="_blank"
          rel="noopener"
          class="text-sm text-text-secondary hover:text-accent transition-colors inline-flex items-center gap-1.5"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M7 1.75a5.25 5.25 0 100 10.5 5.25 5.25 0 000-10.5z" stroke="currentColor" stroke-width="1.2" />
            <path d="M5.25 7l1.25 1.25L9.25 5.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Support the project
        </a>
        <a
          href="https://github.com/kirtan-shah/NeverMiss"
          target="_blank"
          rel="noopener"
          class="text-sm text-text-secondary hover:text-accent transition-colors inline-flex items-center gap-1.5"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
            <path d="M7 0C3.13 0 0 3.13 0 7c0 3.1 2 5.71 4.79 6.64.35.06.48-.15.48-.33 0-.17-.01-.71-.01-1.3-1.76.33-2.21-.43-2.35-.82-.08-.2-.42-.82-.72-.99-.24-.13-.59-.46-.01-.47.55-.01.95.51 1.08.72.63 1.06 1.64.76 2.04.58.06-.46.25-.76.45-.93-1.56-.18-3.18-.78-3.18-3.46 0-.76.27-1.39.72-1.88-.07-.18-.31-.89.07-1.85 0 0 .59-.19 1.93.72.56-.16 1.15-.24 1.75-.24.6 0 1.19.08 1.75.24 1.34-.91 1.93-.72 1.93-.72.38.97.14 1.68.07 1.85.44.49.72 1.11.72 1.88 0 2.69-1.63 3.28-3.19 3.46.25.22.47.64.47 1.3 0 .93-.01 1.69-.01 1.92 0 .19.13.4.48.33A7.008 7.008 0 0014 7c0-3.87-3.13-7-7-7z" />
          </svg>
          View source
        </a>
      </div>
    </div>
  </div>
</section>
