---
const menubarFeature = {
  title: "Lives in Your Menu Bar",
  icon: "menubar",
  iconColor: "text-urgency-medium",
  iconBg: "bg-urgency-medium/10",
};

const otherFeatures = [
  {
    title: "One-Click Join",
    description: "Detects meeting links automatically — Google Meet, Zoom, Teams, WebEx, and more.",
    icon: "join",
    iconColor: "text-accent",
    iconBg: "bg-accent/10",
  },
  {
    title: "Smart Timing",
    description: "Get reminded at 5, 2, or 1 minute before — or set your own schedule. Or use the snooze button.",
    icon: "timing",
    iconColor: "text-urgency-high",
    iconBg: "bg-urgency-high/10",
  },
  {
    title: "Full Screen Alerts",
    description: "Customize full screen alerts with sounds.",
    icon: "alerts",
    iconColor: "text-accent",
    iconBg: "bg-accent/10",
  },
  {
    title: "Multi-Monitor Support",
    description: "Show alerts on your main screen, all screens, or just the primary monitor.",
    icon: "monitors",
    iconColor: "text-urgency-low",
    iconBg: "bg-urgency-low/10",
  },
];
---

<section id="features" class="pt-28 sm:pt-36 pb-24 sm:pb-32">
  <div class="max-w-6xl mx-auto px-6">
    <div class="reveal text-center mb-16 sm:mb-20">
      <span class="inline-block text-[11px] font-medium uppercase tracking-[0.08em] text-accent bg-accent/10 border border-accent/20 rounded-full px-3.5 py-1 mb-4">Features</span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.08]">
        Features
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-5 items-start">
      <!-- Left: Lives in Your Menu Bar (tall, with screenshot) -->
      <div class="reveal group glass bezel-highlight rounded-2xl p-7 shadow-instrument transition-all duration-300 hover:shadow-instrument-hover hover:-translate-y-1 lg:col-span-2">
        <div class={`w-12 h-12 rounded-full ${menubarFeature.iconBg} flex items-center justify-center mb-5`}>
          <svg width="22" height="22" viewBox="0 0 20 20" fill="none" class={menubarFeature.iconColor}>
            <rect x="2" y="3" width="16" height="3" rx="1" stroke="currentColor" stroke-width="1.5" />
            <path d="M4 10h12M4 14h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </div>
        <h3 class="font-display font-semibold text-lg tracking-[-0.01em] mb-3 group-hover:text-text-primary transition-colors">
          {menubarFeature.title}
        </h3>
        <img
          src="/menubar-screenshot.webp"
          alt="NeverMiss menu bar popover showing upcoming meetings"
          width="351"
          height="280"
          class="w-full rounded-xl shadow-instrument opacity-90 group-hover:opacity-100 transition-opacity"
        />
      </div>

      <!-- Right: 2×2 grid of remaining features -->
      <div class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-5">
        {otherFeatures.map((feature) => (
          <div class="reveal group glass bezel-highlight rounded-2xl p-7 shadow-instrument transition-all duration-300 hover:shadow-instrument-hover hover:-translate-y-1">
            <div class={`w-12 h-12 rounded-full ${feature.iconBg} flex items-center justify-center mb-5`}>
              {feature.icon === "join" && (
                <svg width="22" height="22" viewBox="0 0 20 20" fill="none" class={feature.iconColor}>
                  <path d="M13 10l-4-3v6l4-3z" fill="currentColor" />
                  <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5" />
                </svg>
              )}
              {feature.icon === "timing" && (
                <svg width="22" height="22" viewBox="0 0 20 20" fill="none" class={feature.iconColor}>
                  <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5" />
                  <path d="M10 6v4h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="10" cy="10" r="1" fill="currentColor" />
                </svg>
              )}
              {feature.icon === "alerts" && (
                <svg width="22" height="22" viewBox="0 0 20 20" fill="none" class={feature.iconColor}>
                  <path d="M10 2a6 6 0 00-6 6v3l-1.5 2.5h15L16 11V8a6 6 0 00-6-6zM8 16a2 2 0 004 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {feature.icon === "monitors" && (
                <svg width="22" height="22" viewBox="0 0 20 20" fill="none" class={feature.iconColor}>
                  <rect x="1" y="3" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3" />
                  <path d="M4 15h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                  <rect x="9" y="6" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.3" />
                  <path d="M12 16h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                </svg>
              )}
            </div>
            <h3 class="font-display font-semibold text-lg tracking-[-0.01em] mb-2 group-hover:text-text-primary transition-colors">
              {feature.title}
            </h3>
            <p class="text-[15px] text-text-secondary leading-relaxed">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
