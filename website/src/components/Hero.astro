---

---

<section class="relative min-h-[100dvh] flex items-center justify-center pt-16 overflow-hidden">
  <!-- Atmospheric glow layered on top -->
  <div class="hero-glow-far absolute inset-0 pointer-events-none"></div>
  <div class="hero-glow-mid absolute inset-0 pointer-events-none"></div>

  <!-- Concentric radar circles -->
  <div class="absolute top-1/2 right-[15%] -translate-y-1/2 pointer-events-none hidden lg:block" aria-hidden="true">
    <div class="relative w-[600px] h-[600px]">
      <div class="absolute inset-0 rounded-full border border-separator/[0.04]" style="animation: pulse-ring 8s ease-out infinite;"></div>
      <div class="absolute inset-12 rounded-full border border-separator/[0.05]" style="animation: pulse-ring 8s ease-out 2s infinite;"></div>
      <div class="absolute inset-24 rounded-full border border-separator/[0.06]" style="animation: pulse-ring 8s ease-out 4s infinite;"></div>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 py-20 flex flex-col lg:flex-row items-center gap-10 lg:gap-12">
    <!-- Copy -->
    <div class="flex-1 text-center lg:text-left shrink-0 lg:basis-[40%]">
      <div class="reveal">
        <span class="inline-flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.08em] text-text-secondary bg-bg-surface/80 border border-separator/50 rounded-full px-3.5 py-1.5 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-urgency-low animate-pulse"></span>
          macOS 15 Sequoia or later
        </span>
      </div>

      <h1 class="reveal font-display text-5xl sm:text-6xl lg:text-[5.5rem] font-bold tracking-[-0.03em] leading-[1.02] mb-6">
        Never miss another
        <span class="relative inline-block">
          <span class="bg-gradient-to-r from-[#5E9EFF] via-[#7FBFFF] to-[#30D158] bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient-shift">meeting</span>
        </span>.
      </h1>

      <p class="reveal text-xl sm:text-2xl font-light text-text-secondary max-w-lg mx-auto lg:mx-0 mb-10 leading-relaxed">
        Smart, beautiful reminders that live in your menu bar. Connects to Google Calendar and macOS Calendar — alerts you exactly when it matters.
      </p>

      <div class="reveal flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
        <a
          href="https://ko-fi.com/s/711502489b"
          target="_blank"
          rel="noopener"
          class="group relative inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full bg-gradient-to-r from-accent to-[#7FBFFF] text-white font-semibold text-base whitespace-nowrap transition-all duration-300 hover:shadow-glow-accent hover:scale-[1.02]"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 transition-transform duration-200 group-hover:translate-y-0.5">
            <path d="M9 2.25v10.5M4.5 8.25L9 12.75l4.5-4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M3 15.75h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          Download for macOS
        </a>
        <a
          href="https://github.com/kirtan-shah/NeverMiss"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full text-text-secondary hover:text-text-primary border border-separator/50 hover:border-accent/30 transition-colors text-sm whitespace-nowrap"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" class="shrink-0">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
          View on GitHub
        </a>
      </div>
    </div>

    <!-- MacBook Pro 14 frame with transparent screen overlay -->
    <div class="reveal-scale flex-1 relative w-full lg:basis-[60%] min-w-0">
      <!-- Near glow layer behind MacBook -->
      <div class="hero-glow-near absolute -inset-16 pointer-events-none"></div>

      <div class="relative animate-float">
        <!-- Container matches the full MacBook PNG aspect ratio (3944:2564) -->
        <div class="relative" style="aspect-ratio: 3944 / 2564;">
          <!-- Screen content: positioned over the transparent screen area -->
          <!-- Insets measured from PNG pixel analysis: top 14.2%, left 10.3%, right 10.3%, bottom 11.9% -->
          <div class="absolute overflow-hidden"
               style="top: 14.2%; left: 10.3%; right: 10.3%; bottom: 11.9%; border-radius: 3px;">
            <img src="/screenshot.png" class="w-full h-full object-cover object-top" alt="NeverMiss app screenshot" />
          </div>
          <!-- MacBook Pro 14 frame PNG overlaid on top -->
          <img src="/macbook-frame.webp"
               alt=""
               aria-hidden="true"
               width="1600"
               height="1040"
               class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none" />
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-text-tertiary animate-bounce">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
      <path d="M10 4v12M5 11l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>
