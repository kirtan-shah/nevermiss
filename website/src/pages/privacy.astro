---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { marked } from 'marked';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

const html = marked.parse(readFileSync(resolve(process.cwd(), '../privacy_policy.md'), 'utf-8'));
---

<Layout title="Privacy Policy — NeverMiss" description="NeverMiss privacy policy. No data collected. Ever.">
  <Nav />
  <div class="min-h-screen bg-bg-primary pt-24 pb-20">
    <div class="max-w-2xl mx-auto px-6">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-text-secondary hover:text-text-primary transition-colors mb-10">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 3L5 8l5 5"/>
        </svg>
        Back to NeverMiss
      </a>
      <article class="
        [&_h1]:font-display [&_h1]:text-4xl [&_h1]:font-bold [&_h1]:tracking-tight [&_h1]:mb-8 [&_h1]:text-text-primary
        [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-text-primary
        [&_h3]:font-display [&_h3]:text-base [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-text-primary
        [&_p]:text-text-secondary [&_p]:leading-relaxed [&_p]:mb-4
        [&_a]:text-accent [&_a:hover]:underline
        [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-4
        [&_li]:text-text-secondary [&_li]:mb-1
        [&_code]:font-mono [&_code]:text-accent [&_code]:bg-bg-surface [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded
        [&_strong]:text-text-primary [&_strong]:font-semibold
        [&_hr]:border-separator [&_hr]:my-8
      ">
        <Fragment set:html={html} />
      </article>
    </div>
  </div>
  <Footer />
</Layout>
